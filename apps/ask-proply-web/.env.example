# The live path remains disabled unless this is exactly "true".
ASK_PROPLY_LIVE_ENABLED=false

# Exact public AWS API route. The application accepts only HTTPS and /v1/research.
ASK_PROPLY_CONTROL_PLANE_URL=https://replace.invalid/v1/research

# Exact browser origin for same-origin request checks.
ASK_PROPLY_PUBLIC_ORIGIN=https://replace.invalid

# Fixed deployment region and the least-privilege role assumed through Vercel OIDC.
AWS_REGION=eu-west-2
AWS_ROLE_ARN=arn:aws:iam::000000000000:role/replace-with-ask-proply-role
