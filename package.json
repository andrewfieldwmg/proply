{
  "name": "proply-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:research-api": "npm --workspace @proply/research-api run build",
    "start": "next start",
    "check": "next typegen && tsc --noEmit --incremental false",
    "check:research-api": "npm --workspace @proply/research-api run check",
    "test": "node --test scripts/lib/*.test.mjs src/acquisition/*.test.mjs src/worker/*.test.mjs",
    "verify:public-boundary": "node scripts/check-public-boundary.mjs",
    "verify:research-boundary": "node scripts/verify-research-boundary.mjs",
    "verify": "npm run verify:public-boundary && npm test && npm run check && npm run check:research-api && npm run build && npm run build:research-api"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "next": "16.4.2",
    "pg": "8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "7.0.2"
  }
}
